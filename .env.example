VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Vercel → Settings → Environment Variables (Production + Preview)
# Copia también SUPABASE_URL y VITE_SUPABASE_ANON_KEY; el login las usa en el servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui
TWILIO_WHATSAPP_NUMBER=+17372508034
# Plantilla WhatsApp con variable {{1}} = código. Obligatoria en cuentas trial (error 21654).
# No uses la plantilla de citas HXfe5ab5f00277942d4d4200328b4d403c: no incluye el código.
TWILIO_CONTENT_SID=

# Mismo valor que pulse_internal_config.otp_secret
PULSE_OTP_SECRET=

# Login: false o vacío = registro directo (demo). true = WhatsApp OTP de 6 dígitos.
ENABLE_WHATSAPP_OTP=false
# Opcional: reflejar en build local (producción usa auth-config del servidor).
VITE_ENABLE_WHATSAPP_OTP=false
