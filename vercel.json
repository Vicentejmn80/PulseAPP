{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/pulse.ts": {
      "includeFiles": "api/_lib/**"
    },
    "api/send-otp.ts": {
      "includeFiles": "api/_lib/**"
    },
    "api/auth/*.ts": {
      "includeFiles": "api/_lib/**"
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
